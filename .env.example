# AI Body Scan SaaS - Environment Variables Template
# ================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Supabase Configuration
# -------------------
SUPABASE_URL=https://blsettabymllulsxtziw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
POSTGRES_URL=postgresql://postgres:your_password@db.blsettabymllulsxtziw.supabase.co:5432/postgres

# Paystack Configuration (for payments)
# -------------------
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_CALLBACK_URL=https://korra.work/api/paystack/verify
PAYSTACK_WEBHOOK_URL=https://korra.work/api/webhooks/paystack

# Server Configuration
# -------------------
PORT=5001
ENVIRONMENT=development
DEBUG=true

# Replicate (for OOTDiffusion virtual try-on)
# -------------------
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_TRYON_MODEL=viktorfa/oot_diffusion

# Model Configuration
# -------------------
MODEL_PATH=./models

# ================================================
# SNAPCHAT CAMERA KIT CONFIGURATION
# ================================================
# Get these from: https://kit.snapchat.com/manage

# Public OAuth 2.0 Client ID (for frontend)
SNAP_PUBLIC_CLIENT_ID=your_public_client_id

# API Tokens
# Staging (watermark applied, for development)
SNAP_API_TOKEN_STAGING=your_staging_api_token

# Production (no watermark, for live)
SNAP_API_TOKEN_PRODUCTION=your_production_api_token

# Active API Token (use staging for dev, production for live)
SNAP_API_TOKEN=${SNAP_API_TOKEN_STAGING}

# Confidential Client (for server-side authentication)
SNAP_CONFIDENTIAL_CLIENT_ID=your_confidential_client_id
SNAP_CONFIDENTIAL_CLIENT_SECRET=your_confidential_client_secret

# Lens Configuration (get from Lens Scheduler after publishing)
# https://my-lenses.snapchat.com/camera-kit/lens-scheduler
SNAP_LENS_GROUP_ID=your_lens_group_id_here
SNAP_CLOTHING_TRYON_LENS_ID=your_clothing_tryon_lens_id_here
